# Database Configuration
# - For Docker Compose (using container name 'mongodb' as hostname):
#   DB_CONNECTION_STRING=mongodb://mongodb:27017/short-url
# - For local host development (outside of Docker container):
#   DB_CONNECTION_STRING=mongodb://localhost:27017/short-url
# - For production remote database (e.g. MongoDB Atlas):
#   DB_CONNECTION_STRING=mongodb+srv://user:pass@cluster.mongodb.net/database
DB_CONNECTION_STRING=mongodb://mongodb:27017/short-url
LOCAL_DB_CONNECTION_STRING=mongodb://localhost:27017/short-url

# Server Configuration
PORT=3000

# Security Keys
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
SECRET_KEY=your_32_character_aes_encryption_key_here_32_chars

# Rate Limiting
RATE_LIMIT=100